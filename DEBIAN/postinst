#!/bin/bash
# Post-installation script for crocson .deb package

set -e

echo "Running post-installation script..."

ACTION="$1"
OLD_VERSION="$2"

case "$ACTION" in
    configure)
        # First installation or reconfiguration
        if [ -z "$OLD_VERSION" ]; then
            echo "Configuring crocson for first installation..."
        else
            echo "Reconfiguring crocson (upgraded from $OLD_VERSION)..."
        fi
        ;;
        
    abort-upgrade|abort-remove|abort-deconfigure)
        echo "Installation/upgrade was aborted, rolling back..."
        exit 1
        ;;
        
    *)
        echo "Unknown action: '$ACTION'"
        exit 0
        ;;
esac

# Extract and run installation from the included tar.xz
if [ -f "/usr/share/crocson/crocson.tar.xz" ]; then
    echo "Installing crocson files..."
    
    # Create temporary directory
    TEMP_DIR=$(mktemp -d)
    trap "rm -rf $TEMP_DIR" EXIT
    
    # Extract to temporary directory
    tar -xf "/usr/share/crocson/crocson.tar.xz" -C "$TEMP_DIR"
    
    # Run system installation
    make -C "$TEMP_DIR" -f Makefile install
    
    # Clean up
    rm -rf "$TEMP_DIR"
    
    echo "crocson installation completed."
    echo "Run it with: gtk-launch com.github.abakum.crocson"
else
    echo "ERROR: crocson.tar.xz not found in /usr/share/crocson/"
    exit 1
fi

echo "Post-installation script finished."